<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. The system crops this to a circle covering the middle
     two-thirds of the canvas, so the logo is inset to stay fully inside it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo"
    android:insetLeft="22%"
    android:insetTop="22%"
    android:insetRight="22%"
    android:insetBottom="22%" />
